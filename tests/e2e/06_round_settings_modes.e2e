# Round Settings Mode Switching
# Tests that clicking > and < on the navigation bar cycles through modes
# Does not depend on which mode is initially active

disable_animations

goto_screen RoundSettings
wait 0.2
expect_text "select map"
expect_text "back"
screenshot rs_01_initial

# Click > four times to cycle through all modes and back
click_button ">"
wait 0.2
screenshot rs_02_mode_2

click_button ">"
wait 0.2
screenshot rs_03_mode_3

click_button ">"
wait 0.2
screenshot rs_04_mode_4

click_button ">"
wait 0.2
screenshot rs_05_mode_wrap

# Click < to go back one mode
click_button "<"
wait 0.2
screenshot rs_06_mode_back

# Return to main
goto_screen Main
wait 0.2
