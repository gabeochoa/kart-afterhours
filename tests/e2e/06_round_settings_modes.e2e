# Round Settings Mode Switching
# Tests switching between win conditions and verifying each mode renders

disable_animations

goto_screen RoundSettings
wait 0.2
expect_text "select map"
expect_text "back"
screenshot rs_01_initial

# Tab through controls to navigation bar
tab
wait 0.1
tab
wait 0.1

# Arrow right to switch win condition
arrow right
wait 0.2
screenshot rs_02_mode_2

arrow right
wait 0.2
screenshot rs_03_mode_3

arrow right
wait 0.2
screenshot rs_04_mode_4

# Go back to first mode
arrow left
wait 0.1
arrow left
wait 0.1
arrow left
wait 0.2
screenshot rs_05_back_to_mode_1

# Return to main
goto_screen Main
wait 0.2
