# Settings Screen Interactions
# Volume meters, the screen toggles, and back navigation.

disable_animations

goto_screen Settings
wait 0.2

expect_text "OPTIONS"
expect_text "SOUND"
expect_text "SCREEN"
expect_text "SAVED AUTOMATICALLY"
expect_text "MASTER"
expect_text "SIZE"
expect_text "FULLSCREEN"
expect_text "FILTER"

# The three volume rows are why this screen was rebuilt: each was a 400px
# imm::slider in a 372px column, so they overlapped each other and their own
# parent. Pinned at 40px apart, inside a panel that runs x=36..604.
assert_ui row_master y=150 h=40
assert_ui row_music y=190 h=40
assert_ui row_effects y=230 h=40
assert_ui row_master_meter x=230 w=340
assert_ui sound_panel x=64 w=568
screenshot settings_int_01_initial

# Toggles are custom rows, not imm::checkbox, so they are clicked by id.
click_ui row_fullscreen_switch
wait 0.2
screenshot settings_int_02_fullscreen_toggled

click_ui row_filter_switch
wait 0.2
screenshot settings_int_03_postproc_toggled

click_ui row_fullscreen_switch
wait 0.2
screenshot settings_int_04_fullscreen_restored

click_ui row_filter_switch
wait 0.2
screenshot settings_int_05_postproc_restored

# The meter is a div; its drag listener is the only thing making it a control.
# A click lands at the element centre, so the value must land on 50.
click_ui row_master_meter
wait 0.2
assert_ui row_master_value text=50
screenshot settings_int_06_master_dragged

click_ui btn_back
wait 0.2
assert_ui btn_play hidden=false
screenshot settings_int_07_back_to_main
