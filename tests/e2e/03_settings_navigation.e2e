# Settings Screen Navigation
# Drives the focused volume meter with the arrow keys, then tabs onward.

disable_animations

goto_screen Settings
wait 0.2
screenshot settings_01_initial

# Focus starts on the first meter. The meter is a hand-drawn control, so its
# left/right listener is ours -- if it goes missing these three assertions are
# the only thing that notices.
assert_ui row_master_value text=10

arrow right
wait 0.1
assert_ui row_master_value text=15
screenshot settings_02_master_up

arrow left
wait 0.1
assert_ui row_master_value text=10
screenshot settings_03_master_restored

# Tab through the rest of the controls
tab
wait 0.1
screenshot settings_04_tab_music

tab
wait 0.1
screenshot settings_05_tab_effects

tab
wait 0.1
screenshot settings_06_tab_size

# Return to main
goto_screen Main
wait 0.2
