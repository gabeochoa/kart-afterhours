# Settings Screen Interaction
# Tests tabbing through settings controls

disable_animations

goto_screen Settings
wait 0.2
screenshot settings_01_initial

# Tab through controls
tab
wait 0.1
screenshot settings_02_tab1

tab
wait 0.1
screenshot settings_03_tab2

tab
wait 0.1
screenshot settings_04_tab3

# Arrow keys to interact with focused control
arrow right
wait 0.1
screenshot settings_05_arrow_right

arrow left
wait 0.1
screenshot settings_06_arrow_left

# Return to main
goto_screen Main
wait 0.2
