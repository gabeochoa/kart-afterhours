# All Screens Baseline Test
# Visits every screen with animations disabled, validates text, takes screenshots
# This is the primary visual regression test

disable_animations

# Main Menu
goto_screen Main
wait 0.2
assert_ui btn_play hidden=false
assert_ui btn_howtoplay hidden=false
assert_ui btn_options hidden=false
assert_ui btn_quit hidden=false
screenshot 01_main_menu

# Settings Screen
goto_screen Settings
wait 0.2
expect_text_i "back"
expect_text "MASTER"
expect_text "MUSIC"
expect_text "EFFECTS"
expect_text "SIZE"
expect_text "LANGUAGE"
expect_text "FULLSCREEN"
expect_text "FILTER"
screenshot 02_settings

# About Screen
goto_screen About
wait 0.2
expect_text_i "back"
screenshot 03_about

# Character Creation Screen
goto_screen CharacterCreation
wait 0.2
assert_ui btn_next hidden=false
assert_ui btn_back hidden=false
screenshot 04_character_creation

# Round Settings Screen
goto_screen RoundSettings
wait 0.2
assert_ui btn_select_map hidden=false
assert_ui btn_back hidden=false
# By id, not by label: weapon names are translated now, so "Cannon" is not
# text the player ever sees.
assert_ui weapon_row_0 hidden=false
assert_ui weapon_row_1 hidden=false
assert_ui weapon_row_2 hidden=false
assert_ui weapon_row_3 hidden=false
screenshot 05_round_settings

# Map Selection Screen
goto_screen MapSelection
wait 0.2
expect_text_i "back"
screenshot 06_map_selection

# Return to Main Menu
goto_screen Main
wait 0.2
screenshot 07_main_menu_return
